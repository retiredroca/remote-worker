# Gradle
.gradle/
build/
run/

# CMake (the C++ agent side)
build-cpp/
cmake-build-*/

# Local release artifacts (generated by build / CI)
dist/changelog.md
# The staged agent binary is remote-worker-<version>-<os>-<arch>, with no extension on anything but
# Windows -- so matching on *.exe misses it, and a local (non---ci) release on a Linux host would
# leave an untracked binary in the release directory. Match the name, not the extension. The jars
# are listed separately because a module with a different id would not carry this prefix.
dist/remote-worker-*
dist/*.jar

# Local working notes. Untracked deliberately: these are notes to self, full of machine-specific
# facts and half-finished reasoning, and they are not something a reader of this repository should be
# handed. The durable version of each finding is in the code, its comment, or a test.
AGENTS.md
GOTCHAS.md

