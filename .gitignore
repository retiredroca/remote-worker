# Gradle
.gradle/
build/
run/

# CMake (the C++ agent side)
build-cpp/
cmake-build-*/

# Local release artifacts (generated by build / CI)
dist/*.jar
dist/**/*.jar
dist/changelog.md
# The staged agent binary, for the same reason as the jars above. Without this line the release
# script's own output directory would be a source of untracked files that show up in git status.
dist/*.exe
dist/**/*.exe

# Local working notes. Untracked deliberately: these are notes to self, full of machine-specific
# facts and half-finished reasoning, and they are not something a reader of this repository should be
# handed. The durable version of each finding is in the code, its comment, or a test.
AGENTS.md
GOTCHAS.md

