# Gradle
.gradle/
build/
run/

# CMake (the C++ agent side)
build-cpp/
cmake-build-*/

# Local release artifacts (generated by build / CI)
dist/*.jar
dist/**/*.jar
dist/changelog.md
# The staged agent binary, for the same reason as the jars above. Without this line the release
# script's own output directory would be a source of untracked files that show up in git status.
dist/*.exe
dist/**/*.exe

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
.classpath
.project
.settings/
bin/

# Python (release tooling)
__pycache__/
*.pyc

# OS
.DS_Store
Thumbs.db
